{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/papers",
      "destination": "/papers.html"
    },
    {
      "source": "/benchmarks",
      "destination": "/benchmarks.html"
    },
    {
      "source": "/ecosystem",
      "destination": "/ecosystem.html"
    },
    {
      "source": "/verify",
      "destination": "/verify.html"
    },
    {
      "source": "/verify/:file*",
      "destination": "/public-verifier/:file*"
    }
  ],
  "headers": [
    {
      "source": "/(public-verifier|verify)/(.*)\\.(py|hpp|cpp|md|json|txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)\\.(md|tex)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}